rule "notes_rnd" {
  version = 2
  applies {
    source = ["FINANCIAL_STATEMENT_NOTES"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.exact = ["ResearchAndDevelopmentExpense","ResearchAndDevelopmentExpenseExcludingAcquiredInProcessCost","InProcessResearchAndDevelopmentExpense","ResearchAndDevelopmentExpenseSoftwareExcludingAcquiredInProcessCost","ResearchDevelopmentAndEngineeringExpenseNet","ResearchAndDevelopmentExpenseNet","OtherResearchAndDevelopmentExpense","ProductDevelopmentExpense","ResearchAndDevelopmentExpenses","ResearchAndDevelopmentAndEngineeringExpense","ResearchDevelopmentAndPatentExpense","ResearchAndDevelopmentExpenseNetOfGrantReimbursement","ResearchAndDevelopmentExcludingInProcessExpense","ResearchAndDevelopmentExpenseExcludingInProgressResearchAndDevelopment","ResearchAndDevelopmentExpenseNetOfAdjustments","EngineeringAndProductDevelopmentExpense","ResearchAndDevelopmentCosts","ResearchDevelopmentAndEngineeringExpenses","ResearchDevelopmentAndEngineeringExpenseNet","ResearchAndDevelopmentExpenseNet","ResearchAndDevelopmentExpenseExcludingAcquiredInProcessCostNet","ResearchAndDevelopmentInOperatingExpense","ResearchAndDevelopmentExpensesNet"]
    concept.matches = ["(?i)(researchanddevelopment|researchdevelopment).*(expense|cost)","(?i)(product|technology|software)development(expense|cost)"]
    concept.excludes = ["(?i)deferredtax","(?i)capitalized","(?i)softwaredevelopment","(?i)siteandsoftware","(?i)propertyplantandequipment","(?i)amortiz","(?i)stockbasedcompensation","(?i)transitiontax","(?i)taxcuts","(?i)reversal","(?i)increaseanddecrease","(?i)incomeexpense","(?i)benefit","(?i)accrued","(?i)(selling|administrative|costofrevenue).*(researchanddevelopment|researchdevelopment)","(?i)(researchanddevelopment|researchdevelopment).*(selling|administrative|costofrevenue)"]
    label.matches = ["(?i)research\\s+and\\s+development","(?i)\\bR&D\\b","(?i)\\b(product|technology|software)\\s+development\\s+(expense|costs?)\\b"]
    label.excludes = ["(?i)\\bpolicy\\b","(?i)\\bmember\\b","(?i)\\btable\\b","(?i)\\bschedule\\b","(?i)\\brollforward\\b","(?i)\\breserve\\b","(?i)\\boil\\s+and\\s+gas\\s+reserves\\b","(?i)\\bfuture\\s+net\\s+cash\\s+flows\\b","(?i)\\bdeferred\\s+tax\\b","(?i)\\bcapitalized\\b","(?i)\\bsoftware\\s+development\\s+costs?\\b","(?i)\\bamortization\\b","(?i)\\bstock[- ]based\\s+compensation\\b"]
    report.matches = ["(?i)statement","(?i)operations","(?i)income"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "IS"
    entity = "filing.entity"
    dimensions = "CONSOLIDATED_OR_NONE"
  }
  emit {
    canonical = "RND"
    amount = "abs"
    cash_direction = ""
  }
  legacy {
    group = "notes_rules"
    index = 0
    id = "notes_rnd"
    fields = ["id","canonical_id","fs_type","tags","tag_patterns","tag_exclude_patterns","label_patterns","label_exclude_patterns","report_name_patterns","amount_policy"]
  }
}

