  match fact {
    concept.primary = ["us-gaap:FiniteLivedIntangibleAssetsNet"]
    concept.alternate = ["us-gaap:IntangibleAssetsNetExcludingGoodwill","us-gaap:OtherIntangibleAssetsNet","ifrs-full:IntangibleAssetsOtherThanGoodwill"]
    label.matches = ["(?i)\\bintangible\\s+assets?\\b"]
    label.excludes = ["(?i)\\bgoodwill\\b"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
