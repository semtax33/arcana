    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "CF"
    entity = "filing.entity"
    dimensions = "CONSOLIDATED_OR_NONE"
  }
  emit {
    canonical = "DIV_PAID"
    amount = "abs"
    cash_direction = "outflow"
  }
  legacy {
    group = "notes_rules"
    index = 11
    id = "notes_dividends_paid"
    fields = ["id","canonical_id","fs_type","tags","tag_patterns","tag_exclude_patterns","label_patterns","label_exclude_patterns","report_name_patterns","amount_policy","cash_direction"]
  }
}

rule "notes_buyback" {
  version = 2
  applies {
    source = ["FINANCIAL_STATEMENT_NOTES"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.exact = ["PaymentsForRepurchaseOfCommonStock","PaymentsForRepurchaseOfEquity","PaymentsForRepurchaseOfPreferredStockAndPreferenceStock","PaymentsForRepurchaseOfRedeemablePreferredStock","PaymentsForRepurchaseOfRedeemableConvertiblePreferredStock","PaymentsForRepurchaseOfConvertiblePreferredStock","PaymentsForRepurchaseOfOtherEquity","PaymentsForRepurchaseOfTreasuryStock","PaymentsForRepurchaseOfCommonStockAndOtherRelatedCosts","NetPaymentsForRepurchaseOfCommonStock","PaymentsForRepurchaseOfCommonStockShareRepurchaseProgram","PaymentsForRepurchaseOfCommonStockAndWarrants","PaymentsForRepurchaseOfCommonStockIncludingRelatedExpenses","PaymentsForRepurchaseOfStockAndCancellationOfShares","PaymentsForRepurchaseOfCommonStockOpenMarket","PaymentsForRepurchaseOfCommonStockInTheOpenMarket","PaymentsForRepurchaseOfRedeemableCommonStock","PaymentsforRepurchaseofRedeemableCommonStock","PaymentsForRepurchaseOfCommonStockUnderShareRepurchaseProgram","PaymentsForRepurchaseOfCommonStockTreasuryShares","PaymentsForRepurchaseOfCommonStockForTreasury","PaymentsForRepurchaseOfCommonStockAsTreasuryStock","PaymentsforRepurchaseofCommonStockintheOpenMarket","PaymentsForRepurchaseOfStockHeldInTreasury","PaymentsForRepurchaseOfTresuryStock"]
    concept.matches = ["(?i)paymentsforrepurchaseof.*(stock|equity)"]
    concept.excludes = ["(?i)taxwithholding","(?i)taxes","(?i)withheld","(?i)surrendered","(?i)equityaward","(?i)restrictedstock","(?i)stockoptions?","(?i)deferredcompensation","(?i)payrolltax","(?i)noncontrolling","(?i)subsidiar","(?i)federaldepositinsurance","(?i)insurancecorporation"]
    label.matches = ["(?i)\\bpayments?\\s+for\\s+repurchase\\s+of\\s+(common\\s+)?stock\\b","(?i)\\bpayments?\\s+for\\s+repurchase\\s+of\\s+.*stock\\b","(?i)\\bpayments?\\s+for\\s+repurchase\\s+of\\s+(equity|shares?)\\b","(?i)\\brepurchase\\s+of\\s+(common\\s+)?(stock|shares?)\\b","(?i)\\brepurchase\\s+of\\s+.*stock\\b","(?i)\\btreasury\\s+stock\\s+(purchase|repurchase|acquired)\\b"]
    label.excludes = ["(?i)\\bauthorized\\b","(?i)\\bnumber\\s+of\\s+shares\\b","(?i)\\bshares\\s+repurchased\\b"]
    report.matches = ["(?i)cash\\s+flows?","(?i)financing"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "CF"
    entity = "filing.entity"
    dimensions = "CONSOLIDATED_OR_NONE"
  }
  emit {
    canonical = "BUYBACK"
    amount = "abs"
    cash_direction = "outflow"
  }
  legacy {
    group = "notes_rules"
    index = 12
    id = "notes_buyback"
    fields = ["id","canonical_id","fs_type","tags","tag_patterns","tag_exclude_patterns","label_patterns","label_exclude_patterns","report_name_patterns","amount_policy","cash_direction"]
  }
}

