  }
  legacy {
    group = "companyfacts_rules"
    index = 2
    fields = ["canonical_id","fs_type","primary_tags","alternate_tags","label_patterns"]
  }
}

rule "concept_003_current_assets" {
  version = 2
  applies {
    source = ["FILING_XBRL","COMPANYFACTS"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.primary = ["us-gaap:AssetsCurrent"]
    label.matches = ["(?i)\\bcurrent\\s+assets\\b"]
    label.excludes = ["(?i)\\bnon[- ]current\\b","(?i)\\btotal\\s+assets\\b"]
