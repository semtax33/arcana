ruleset "semantic_us_v2" {
  schema = "arcana.sec-semantic/v2"
  version = 2
  authority = ["FILING_XBRL", "COMPANYFACTS", "FINANCIAL_STATEMENT_NOTES"]
}

rule "concept_000_total_assets" {
  version = 2
  applies {
    source = ["FILING_XBRL","COMPANYFACTS"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.primary = ["us-gaap:Assets"]
    concept.alternate = ["ifrs-full:Assets"]
    label.matches = ["(?i)\\btotal\\s+assets\\b"]
    label.excludes = ["(?i)\\bunder\\s+management\\b"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "BS"
    entity = "filing.entity"
    dimensions = "CONSOLIDATED_OR_NONE"
  }
  emit {
    canonical = "TOTAL_ASSETS"
    amount = "as_reported"
    cash_direction = ""
  }
  legacy {
    group = "companyfacts_rules"
    index = 0
    fields = ["canonical_id","fs_type","primary_tags","alternate_tags","label_patterns","label_exclude_patterns"]
  }
}

rule "concept_001_total_equity" {
  version = 2
  applies {
    source = ["FILING_XBRL","COMPANYFACTS"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.primary = ["us-gaap:StockholdersEquity"]
    concept.alternate = ["us-gaap:StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest","us-gaap:PartnersCapital","us-gaap:CommonStocksIncludingAdditionalPaidInCapital"]
    label.matches = ["(?i)\\b(stockholders'?|shareholders'?|partners')\\s+equity\\b","(?i)\\bmembers'\\s+equity\\b"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "BS"
    entity = "filing.entity"
    dimensions = "CONSOLIDATED_OR_NONE"
  }
  emit {
    canonical = "TOTAL_EQUITY"
    amount = "as_reported"
    cash_direction = ""
  }
  legacy {
    group = "companyfacts_rules"
    index = 1
    fields = ["canonical_id","fs_type","primary_tags","alternate_tags","label_patterns"]
  }
}

