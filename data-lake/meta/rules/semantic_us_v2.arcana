rule "concept_007_cash_and_equivalents" {
  version = 2
  applies {
    source = ["FILING_XBRL","COMPANYFACTS"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.primary = ["us-gaap:CashAndCashEquivalentsAtCarryingValue"]
    concept.alternate = ["us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents","us-gaap:CashCashEquivalentsAndShortTermInvestments","ifrs-full:CashAndCashEquivalents"]
    label.matches = ["(?i)\\bcash\\s+and\\s+cash\\s+equivalents\\b","(?i)\\bcash,\\s*cash\\s+equivalents\\b"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "BS"
    entity = "filing.entity"
    dimensions = "CONSOLIDATED_OR_NONE"
  }
  emit {
    canonical = "CASH_AND_EQUIVALENTS"
    amount = "as_reported"
    cash_direction = ""
  }
  legacy {
    group = "companyfacts_rules"
    index = 7
    fields = ["canonical_id","fs_type","primary_tags","alternate_tags","label_patterns"]
  }
}

