rule "concept_011_ppe" {
  version = 2
  applies {
    source = ["FILING_XBRL","COMPANYFACTS"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.primary = ["us-gaap:PropertyPlantAndEquipmentNet"]
    concept.alternate = ["ifrs-full:PropertyPlantAndEquipment"]
    label.matches = ["(?i)\\bproperty,\\s*plant,?\\s+and\\s+equipment\\b","(?i)\\bproperty\\s+and\\s+equipment\\b"]
    label.excludes = ["(?i)\\bpayments?\\s+to\\s+acquire\\b","(?i)\\bproceeds?\\s+from\\s+sale\\b"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "BS"
    entity = "filing.entity"
    dimensions = "CONSOLIDATED_OR_NONE"
  }
  emit {
    canonical = "PPE"
    amount = "as_reported"
    cash_direction = ""
  }
  legacy {
    group = "companyfacts_rules"
    index = 11
    fields = ["canonical_id","fs_type","primary_tags","alternate_tags","label_patterns","label_exclude_patterns"]
  }
}

