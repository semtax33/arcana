rule "notes_dividends_paid" {
  version = 2
  applies {
    source = ["FINANCIAL_STATEMENT_NOTES"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.exact = ["PaymentsOfDividends","PaymentsOfDividendsCommonStock","PaymentsOfOrdinaryDividends","PaymentsOfDividendsPreferredStockAndPreferenceStock","PaymentsOfOrdinaryDividendsCommonStockAndPreferredStock","PaymentsOfOrdinaryDividendsAndSpecialDividends","PaymentsOfDividendsCommonAndPreferredStock","PaymentsOfOrdinaryDividendsCommonAndPreferredShareholders","PaymentsOfOrdinaryDividendsCommonAndPreferred","PaymentsOfDividendsIncludingExpenses","PaymentsOfDividendsRedeemablePreferredStock","PaymentsOfDividendsToShareholders","PaymentsOfDividendsAndDistributions","PaymentsOfOrdinaryDividendsCommonAndPreferredStock"]
    concept.matches = ["(?i)paymentsof.*dividends"]
    concept.excludes = ["(?i)(minority|noncontrolling)","(?i)dividendequivalent","(?i)equitableadjust","(?i)proceeds","(?i)jointventures","(?i)partnership","(?i)operating"]
    label.matches = ["(?i)\\bdividends?\\s+paid\\b","(?i)\\bpayments?\\s+of\\s+dividends?\\b","(?i)\\bcash\\s+dividends?\\s+paid\\b","(?i)\\bpayments?\\s+of\\s+(ordinary\\s+)?dividends?\\b"]
    label.excludes = ["(?i)\\bdeclared\\b","(?i)\\bpayable\\b","(?i)\\bper\\s+share\\b"]
    report.matches = ["(?i)cash\\s+flows?","(?i)financing"]
  }
  capture {
