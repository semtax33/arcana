  match fact {
    concept.primary = ["us-gaap:InventoryNet"]
    concept.alternate = ["us-gaap:InventoryFinishedGoodsNetOfReserves","ifrs-full:Inventories"]
    label.matches = ["(?i)\\binventor(y|ies)\\b"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "BS"
