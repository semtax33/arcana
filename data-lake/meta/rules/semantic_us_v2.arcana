rule "concept_014_short_term_debt" {
  version = 2
  applies {
    source = ["FILING_XBRL","COMPANYFACTS"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.primary = ["us-gaap:DebtCurrent"]
    concept.alternate = ["us-gaap:ShortTermBorrowings","us-gaap:NotesPayableCurrent","us-gaap:LoansPayableCurrent","us-gaap:LongTermDebtCurrent","us-gaap:LongTermDebtAndCapitalLeaseObligationsCurrent","us-gaap:CommercialPaper","us-gaap:OtherShortTermBorrowings","us-gaap:ShortTermBankLoansAndNotesPayable","us-gaap:OtherLongTermDebtCurrent","ifrs-full:CurrentPortionOfLongtermBorrowings"]
    label.matches = ["(?i)\\b(short[- ]term|current)\\s+(debt|borrowings?)\\b","(?i)\\bcurrent\\s+portion\\s+of\\s+long[- ]term\\s+(debt|borrowings?)\\b"]
    label.excludes = ["(?i)\\binterest\\s+rates?\\b","(?i)\\brate\\s+range\\b","(?i)\\bweighted[- ]average\\s+rate\\b"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "BS"
    entity = "filing.entity"
    dimensions = "CONSOLIDATED_OR_NONE"
  }
  emit {
    canonical = "SHORT_TERM_DEBT"
    amount = "as_reported"
    cash_direction = ""
  }
  legacy {
    group = "companyfacts_rules"
    index = 14
    fields = ["canonical_id","fs_type","primary_tags","alternate_tags","label_patterns","label_exclude_patterns"]
  }
}

rule "concept_015_long_term_debt" {
  version = 2
  applies {
    source = ["FILING_XBRL","COMPANYFACTS"]
    form = ["10-K","10-Q","10-K/A","10-Q/A"]
    accounting = "US_GAAP"
  }
  match fact {
    concept.primary = ["us-gaap:LongTermDebtNoncurrent"]
    concept.alternate = ["us-gaap:LongTermDebt","us-gaap:LongTermNotesPayable","us-gaap:OtherLongTermDebtNoncurrent","us-gaap:LongTermDebtAndCapitalLeaseObligations","ifrs-full:LongtermBorrowings"]
    label.matches = ["(?i)\\blong[- ]term\\s+(debt|borrowings?)\\b","(?i)\\bnon[- ]current\\s+(debt|borrowings?)\\b","(?i)\\b(long[- ]term|non[- ]current)\\s+notes?\\s+payable\\b"]
  }
  capture {
    value = "fact.numeric_value"
    period = "context.period"
    dimensions = "context.dimensions"
  }
  constraint {
    statement = "BS"
    entity = "filing.entity"
    dimensions = "CONSOLIDATED_OR_NONE"
  }
  emit {
    canonical = "LONG_TERM_DEBT"
    amount = "as_reported"
    cash_direction = ""
  }
  legacy {
    group = "companyfacts_rules"
    index = 15
    fields = ["canonical_id","fs_type","primary_tags","alternate_tags","label_patterns"]
  }
}

